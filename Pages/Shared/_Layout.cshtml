<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Listovki Quiz</title>
    <link rel="icon" href="data:," />
    <!-- The styling is split into one file per topic (see wwwroot/css). The order matters: base first. -->
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/history.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" asp-page="/Index">
                <span class="logo-mark">B</span>
                <span class="logo-text">Listovki Quiz</span>
            </a>

            <nav class="nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/History">My attempts</a>
                    <span class="nav-user">@(User.Identity?.Name)</span>
                    <form method="post" asp-page="/Logout" class="inline-form">
                        <button type="submit" class="link-button">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Login">Log in</a>
                    <a class="button small" asp-page="/Register">Register</a>
                }
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">Listovki Quiz &middot; driving theory practice</div>
    </footer>
</body>
</html>
